<%= form_with model: @foundation, url: url, method: method_override do |f| %>
  <% if @foundation.errors.any? %>
    <div class="alert alert-danger">
      <% @foundation.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <% [
    [:values,             "Your 3–5 core values, each with a one-sentence why. E.g. \"Autonomy: I want to control my own time.\""],
    [:strengths,          "3 strengths with specific evidence — projects, outcomes, numbers. Not what you're good at in theory."],
    [:constraints,        "2–3 honest constraints: financial, geographic, family, health. Don't soften them."],
    [:resources,          "3–5 resources you actually have: skills, network, capital, credentials, time per week."],
    [:current_trajectory, "One sentence: what happens if you keep doing exactly what you're doing for the next two years?"]
  ].each do |field, hint| %>
    <div class="mb-4">
      <%= f.label field, class: "form-label fw-medium" %>
      <%= f.text_area field, class: "form-control", rows: 4 %>
      <div class="form-text text-muted"><%= hint %></div>
    </div>
  <% end %>

  <div class="mt-3">
    <%= f.submit submit_text,
          class: "btn w-100 w-md-auto",
          style: "background-color: var(--accent); color: #fff;" %>
  </div>
<% end %>
