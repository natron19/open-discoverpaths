<h1 class="mb-4">Dashboard</h1>

<%# Foundation summary %>
<div class="mb-5">
  <% if @foundation %>
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h5 class="card-title mb-0">Your Foundation</h5>
          <%= link_to "Edit", edit_personal_foundation_path, class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <p class="text-muted small mb-1">
          <strong>Values:</strong> <%= truncate(@foundation.values, length: 120) %>
        </p>
        <p class="text-muted small mb-0">
          <strong>Trajectory:</strong> <%= truncate(@foundation.current_trajectory, length: 120) %>
        </p>
      </div>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body text-center py-5">
        <h5 class="mb-2">Start by writing your foundation</h5>
        <p class="text-muted mb-4">Your foundation is the input for every path set. Without it, you can't generate paths.</p>
        <%= link_to "Start Your Foundation", new_personal_foundation_path,
              class: "btn",
              style: "background-color: var(--accent); color: #fff;" %>
      </div>
    </div>
  <% end %>
</div>

<%# Path Sets section %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Your Path Sets</h4>

  <% if @foundation %>
    <div data-controller="path-generator">
      <%= form_with url: path_sets_path, method: :post,
            data: { turbo: false, action: "submit->path-generator#start" } do %>

        <%# Idle state: generate button %>
        <div data-path-generator-target="idle">
          <button type="submit" class="btn"
                  style="background-color: var(--accent); color: #fff;">
            Generate a New Path Set
          </button>
        </div>

        <%# Loading state: spinner + message + cancel %>
        <div data-path-generator-target="loading" class="d-none">
          <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"
                 style="color: var(--accent);">
              <span class="visually-hidden">Generating&hellip;</span>
            </div>
            <span class="text-muted small">Generating your paths&hellip; usually 20–30 seconds.</span>
            <%= link_to "Cancel", dashboard_path,
                  class: "btn btn-sm btn-outline-secondary",
                  data: { turbo: false } %>
          </div>
        </div>

      <% end %>
    </div>
  <% else %>
    <button class="btn" disabled
            style="background-color: var(--accent); color: #fff; opacity: 0.65;">
      Generate a New Path Set
    </button>
  <% end %>
</div>

<% if @path_sets.any? %>
  <% @path_sets.each do |ps| %>
    <div class="card mb-2">
      <div class="card-body d-flex justify-content-between align-items-center py-3">
        <div>
          <span class="text-muted small">Generated <%= time_ago_in_words(ps.generated_at) %> ago</span>
          <span class="text-muted small">&nbsp;·&nbsp;<%= ps.life_paths.count %> paths</span>
        </div>
        <%= link_to "View", path_set_path(ps), class: "btn btn-sm btn-outline-secondary" %>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-muted">No path sets yet. Generate your first one above.</p>
<% end %>
