<%= turbo_frame_tag "life_path_#{life_path.id}" do %>
  <div class="accordion-item <%= 'exit-path' if life_path.is_exit_path? %> <%= 'long-shot' if life_path.is_long_shot? %>">
    <h2 class="accordion-header">
      <button class="accordion-button <%= 'collapsed' unless open %>" type="button"
              data-bs-toggle="collapse"
              data-bs-target="#path-collapse-<%= life_path.id %>">
        <% if life_path.is_exit_path? %>
          <span class="badge bg-secondary me-2">Exit Path</span>
        <% elsif life_path.is_long_shot? %>
          <span class="badge badge-accent me-2">Long-Shot Path</span>
        <% end %>
        <%= life_path.name %>
      </button>
    </h2>
    <div id="path-collapse-<%= life_path.id %>"
         class="accordion-collapse collapse <%= 'show' if open %>">
      <div class="accordion-body">

        <div class="d-flex justify-content-between align-items-start mb-3">
          <p class="text-muted small mb-0"><%= life_path.positioning %></p>
          <%= link_to "Edit", edit_life_path_path(life_path),
                data: { turbo_frame: "life_path_#{life_path.id}" },
                class: "btn btn-sm btn-outline-secondary py-0 px-2 flex-shrink-0 ms-3" %>
        </div>

        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Milestones</h6>
        <ul class="list-unstyled small mb-3">
          <% life_path.milestones.split("\n").each do |m| %>
            <li><%= m %></li>
          <% end %>
        </ul>

        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Demands</h6>
        <ol class="small mb-3 ps-3">
          <% life_path.demands.split("\n").each do |d| %>
            <li><%= d %></li>
          <% end %>
        </ol>

        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Trade-offs</h6>
        <ol class="small mb-3 ps-3">
          <% life_path.trade_offs.split("\n").each do |t| %>
            <li><%= t %></li>
          <% end %>
        </ol>

        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Real People</h6>
        <ul class="list-unstyled small mb-0">
          <% life_path.real_people.split("\n").each do |p| %>
            <li class="mb-1">— <%= p %></li>
          <% end %>
        </ul>

      </div>
    </div>
  </div>
<% end %>
